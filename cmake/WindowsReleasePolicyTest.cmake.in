set(fixture_root "${CMAKE_CURRENT_BINARY_DIR}/windows-release-policy-fixture")
set(fixture_qt "${fixture_root}/qt")
set(fixture_openssl "${fixture_root}/openssl")
file(REMOVE_RECURSE "${fixture_root}")
file(MAKE_DIRECTORY "${fixture_qt}/bin" "${fixture_openssl}/bin")

foreach(suffix IN ITEMS "" d)
    foreach(qt_base IN ITEMS
            Qt5Core Qt5Gui Qt5Network Qt5Svg Qt5Widgets Qt5WinExtras
            libEGL libGLESv2)
        file(WRITE "${fixture_qt}/bin/${qt_base}${suffix}.dll" "fixture")
    endforeach()
    foreach(plugin_entry IN ITEMS
            "bearer/qgenericbearer${suffix}.dll"
            "platforms/qwindows${suffix}.dll"
            "styles/qwindowsvistastyle${suffix}.dll"
            "iconengines/qsvgicon${suffix}.dll"
            "imageformats/qgif${suffix}.dll"
            "imageformats/qicns${suffix}.dll"
            "imageformats/qico${suffix}.dll"
            "imageformats/qjpeg${suffix}.dll"
            "imageformats/qsvg${suffix}.dll"
            "imageformats/qtga${suffix}.dll"
            "imageformats/qtiff${suffix}.dll"
            "imageformats/qwbmp${suffix}.dll"
            "imageformats/qwebp${suffix}.dll")
        get_filename_component(plugin_dir "${plugin_entry}" DIRECTORY)
        file(MAKE_DIRECTORY "${fixture_qt}/plugins/${plugin_dir}")
        file(WRITE "${fixture_qt}/plugins/${plugin_entry}" "fixture")
    endforeach()
endforeach()
file(WRITE "${fixture_openssl}/bin/libssl-3-x64.dll" "fixture")
file(WRITE "${fixture_openssl}/bin/libcrypto-3-x64.dll" "fixture")

foreach(configuration IN ITEMS Debug Release)
    string(TOLOWER "${configuration}" configuration_lower)
    set(output_dir "${fixture_root}/${configuration_lower}")
    file(MAKE_DIRECTORY "${output_dir}")
    foreach(product_exe IN ITEMS weave.exe weavec.exe weaved.exe weaves.exe)
        file(WRITE "${output_dir}/${product_exe}" "fixture")
    endforeach()
    file(WRITE "${output_dir}/unittests.exe" "must not ship")
    file(WRITE "${output_dir}/guiunittests.exe" "must not ship")
    file(WRITE "${output_dir}/integtests.exe" "must not ship")
    file(WRITE "${output_dir}/weave.pdb" "must not ship")
    file(MAKE_DIRECTORY "${output_dir}/test-fixtures")
    file(WRITE "${output_dir}/test-fixtures/test-helper.dll" "must not ship")

    set(staging_dir "${fixture_root}/stage/${configuration}")
    if (configuration STREQUAL "Release")
        file(MAKE_DIRECTORY "${staging_dir}/payload")
        file(WRITE "${staging_dir}/payload/stale-test.exe"
             "must be removed before staging")
    endif()
    execute_process(
        COMMAND "${CMAKE_COMMAND}"
            -DWIN32=TRUE
            -DBUILD_CONFIGURATION=${configuration}
            -DQT_BIN_DIR=${fixture_qt}/bin
            -DOPENSSL_ROOT_HINT=${fixture_openssl}
            -DOUTPUT_DIR=${output_dir}
            -DSTAGING_DIR=${staging_dir}
            -DTARGET_FILE=${output_dir}/weave.exe
            -P ${gui_deploy}
        RESULT_VARIABLE deploy_result)
    if (NOT deploy_result EQUAL 0)
        message(FATAL_ERROR
                "${configuration} GUI deployment fixture failed: ${deploy_result}")
    endif()

    if (configuration STREQUAL "Debug")
        assert_path_exists("${output_dir}/Qt5Cored.dll")
        assert_path_exists("${output_dir}/platforms/qwindowsd.dll")
        assert_path_absent("${output_dir}/Qt5Core.dll")
    else()
        assert_path_exists("${output_dir}/Qt5Core.dll")
        assert_path_exists("${output_dir}/platforms/qwindows.dll")
        assert_path_absent("${output_dir}/Qt5Cored.dll")
    endif()
    assert_path_exists("${output_dir}/libssl-3-x64.dll")
    assert_path_exists("${output_dir}/libcrypto-3-x64.dll")
    assert_path_absent("${output_dir}/zlib1.dll")
    assert_path_absent("${output_dir}/zlib.dll")

    if (configuration STREQUAL "Release")
        read_release_manifest("${staging_dir}/manifest.sha256"
                              "${staging_dir}/payload"
                              staged_manifest_entries)
        assert_lists_equal("release manifest"
                           staged_manifest_entries expected_release_files)

        file(GLOB_RECURSE staged_payload_entries
             LIST_DIRECTORIES FALSE
             RELATIVE "${staging_dir}/payload"
             "${staging_dir}/payload/*")
        assert_lists_equal("release staging payload"
                           staged_payload_entries expected_release_files)
        read_inno_payload_entries("${staging_dir}/payload-files.iss"
                                  staged_inno_entries)
        assert_lists_equal("Inno Release payload"
                           staged_inno_entries expected_release_files)
        assert_path_absent("${staging_dir}/payload/unittests.exe")
        assert_path_absent("${staging_dir}/payload/guiunittests.exe")
        assert_path_absent("${staging_dir}/payload/integtests.exe")
        assert_path_absent("${staging_dir}/payload/weave.pdb")
        assert_path_absent("${staging_dir}/payload/stale-test.exe")
        assert_path_absent(
            "${staging_dir}/payload/test-fixtures/test-helper.dll")
    endif()
endforeach()
