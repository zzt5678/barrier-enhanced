cmake_policy(VERSION 3.16)

function(assert_file_contains path expected)
    if (NOT EXISTS "${path}")
        message(FATAL_ERROR "required Windows release file does not exist: ${path}")
    endif()

    file(READ "${path}" contents)
    string(FIND "${contents}" "${expected}" position)
    if (position EQUAL -1)
        message(FATAL_ERROR "${path} does not contain: ${expected}")
    endif()
endfunction()

function(assert_file_excludes path unexpected)
    if (NOT EXISTS "${path}")
        message(FATAL_ERROR "required Windows release file does not exist: ${path}")
    endif()

    file(READ "${path}" contents)
    string(FIND "${contents}" "${unexpected}" position)
    if (NOT position EQUAL -1)
        message(FATAL_ERROR "${path} unexpectedly contains: ${unexpected}")
    endif()
endfunction()

function(assert_path_exists path)
    if (NOT EXISTS "${path}")
        message(FATAL_ERROR "expected Windows release artifact is missing: ${path}")
    endif()
endfunction()

function(assert_path_absent path)
    if (EXISTS "${path}")
        message(FATAL_ERROR "unexpected Windows release artifact exists: ${path}")
    endif()
endfunction()

function(assert_lists_equal description actual_var expected_var)
    set(actual ${${actual_var}})
    set(expected ${${expected_var}})
    list(SORT actual)
    list(SORT expected)
    if (NOT "${actual}" STREQUAL "${expected}")
        message(FATAL_ERROR
                "${description} differs\nexpected: ${expected}\nactual: ${actual}")
    endif()
endfunction()

function(read_release_manifest path payload_dir output_var)
    if (NOT EXISTS "${path}")
        message(FATAL_ERROR "Windows release manifest is missing: ${path}")
    endif()

    file(STRINGS "${path}" manifest_lines)
    set(entries)
    foreach(line IN LISTS manifest_lines)
        if (NOT line MATCHES "^([0-9a-f]+)  ([^/].+)$")
            message(FATAL_ERROR "invalid Windows release manifest line: ${line}")
        endif()
        string(LENGTH "${CMAKE_MATCH_1}" hash_length)
        if (NOT hash_length EQUAL 64)
            message(FATAL_ERROR "invalid Windows release manifest hash: ${line}")
        endif()
        set(relative_path "${CMAKE_MATCH_2}")
        if (NOT EXISTS "${payload_dir}/${relative_path}")
            message(FATAL_ERROR
                    "manifest entry is absent from staging: ${relative_path}")
        endif()
        file(SHA256 "${payload_dir}/${relative_path}" actual_hash)
        string(TOLOWER "${actual_hash}" actual_hash)
        if (NOT actual_hash STREQUAL CMAKE_MATCH_1)
            message(FATAL_ERROR
                    "manifest hash does not match staging: ${relative_path}")
        endif()
        list(APPEND entries "${relative_path}")
    endforeach()
    set(${output_var} "${entries}" PARENT_SCOPE)
endfunction()

function(read_wix_payload_entries path output_var)
    file(STRINGS "${path}" source_lines)
    set(entries)
    set(bin_path_marker [=[$(var.BinPath)\]=])
    string(LENGTH "${bin_path_marker}" marker_length)
    foreach(line IN LISTS source_lines)
        string(FIND "${line}" "${bin_path_marker}" marker_position)
        if (marker_position EQUAL -1)
            continue()
        endif()
        math(EXPR relative_start "${marker_position} + ${marker_length}")
        string(SUBSTRING "${line}" ${relative_start} -1 relative_tail)
        string(FIND "${relative_tail}" "\"" quote_position)
        if (quote_position EQUAL -1)
            message(FATAL_ERROR "invalid WiX staged Source: ${line}")
        endif()
        string(SUBSTRING "${relative_tail}" 0 ${quote_position} relative_path)
        string(REPLACE "\\" "/" relative_path "${relative_path}")
        list(APPEND entries "${relative_path}")
    endforeach()
    set(${output_var} "${entries}" PARENT_SCOPE)
endfunction()

function(read_inno_payload_entries path output_var)
    if (NOT EXISTS "${path}")
        message(FATAL_ERROR "Inno Release file list is missing: ${path}")
    endif()
    file(STRINGS "${path}" source_lines)
    set(entries)
    set(stage_marker "{#ReleaseStage}/payload/")
    string(LENGTH "${stage_marker}" marker_length)
    foreach(line IN LISTS source_lines)
        string(FIND "${line}" "${stage_marker}" marker_position)
        if (marker_position EQUAL -1)
            message(FATAL_ERROR "invalid staged Inno Source: ${line}")
        endif()
        math(EXPR relative_start "${marker_position} + ${marker_length}")
        string(SUBSTRING "${line}" ${relative_start} -1 relative_tail)
        string(FIND "${relative_tail}" "\"" quote_position)
        if (quote_position EQUAL -1)
            message(FATAL_ERROR "invalid staged Inno Source: ${line}")
        endif()
        string(SUBSTRING "${relative_tail}" 0 ${quote_position} relative_path)
        list(APPEND entries "${relative_path}")
    endforeach()
    set(${output_var} "${entries}" PARENT_SCOPE)
endfunction()

