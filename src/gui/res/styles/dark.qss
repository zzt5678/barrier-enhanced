QMainWindow, QDialog {
    background: #f5f5f7;
    color: #1d1d1f;
    font-family: "SF Pro Display", "Helvetica Neue", "PingFang SC", "Segoe UI Variable", sans-serif;
    font-size: 10pt;
}

QWidget {
    color: #1d1d1f;
    font-family: "SF Pro Display", "Helvetica Neue", "PingFang SC", "Segoe UI Variable", sans-serif;
    font-size: 10pt;
}

QMenuBar, QMenu {
    background: #fbfbfd;
    color: #1d1d1f;
}

QMenuBar::item {
    padding: 6px 10px;
    border-radius: 8px;
}

QMenuBar::item:selected,
QMenu::item:selected {
    background: #ececf2;
    color: #111113;
}

QFrame#heroCard {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #fafafa, stop:1 #f0f1f5);
    border-radius: 8px;
    border: 1px solid #d6d7dc;
    padding: 8px;
}

QLabel#m_pLabelHeroTitle {
    color: #111113;
    font-size: 16px;
    font-weight: 700;
}

QLabel#m_pLabelHeroSubtitle {
    color: #6e6e73;
    font-size: 9.5pt;
}

QGroupBox {
    background: #fbfbfd;
    border: 1px solid #dfdfe4;
    border-radius: 8px;
    margin-top: 10px;
    padding: 10px 10px 10px 10px;
    font-weight: 600;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 18px;
    padding: 0 6px;
    color: #3c3c43;
    background: #fbfbfd;
}

QLabel {
    background: transparent;
    color: #6e6e73;
}

QLabel#m_pStatusLabel,
QLabel#m_pLabelIpAddresses,
QLabel#m_pLabelScreenName,
QLabel#m_pLabelLocalFingerprint,
QLabel#m_pLabelServerHint,
QLabel#m_pLabelClientHint,
QLabel#m_pLabelModeValue,
QLabel#m_pLabelPeerValue,
QLabel#m_pLabelWorkflowRuntimeValue,
QLabel#m_pLabelWorkflowSectionTitle {
    color: #111113;
    font-weight: 600;
}

QLabel#m_pLabelFeatureHint {
    color: #6e6e73;
    font-size: 9.5pt;
}

QLabel#m_pLabelServerHint,
QLabel#m_pLabelClientHint {
    color: #6e6e73;
    font-size: 9.5pt;
    font-weight: 400;
}

QLabel#m_pLabelModeCaption,
QLabel#m_pLabelPeerCaption,
QLabel#m_pLabelWorkflowRuntimeCaption,
QLabel#m_pLabelReceiptSummary {
    color: #6e6e73;
    font-size: 9pt;
}

QLabel#m_pPermissionTitle,
QLabel#m_pLabelWorkflowSectionTitle {
    font-size: 15pt;
    font-weight: 700;
    color: #111113;
}

QFrame#overviewCard,
QFrame#workflowCard,
QFrame#footerCard,
QFrame#frame_fingerprint_details,
QFrame#m_pPermissionCard,
QFrame#m_pHeaderCard,
QFrame#m_pSettingsHeaderCard {
    background: #fbfbfd;
    border: 1px solid #dfdfe4;
    border-radius: 8px;
}

QFrame#overviewCard,
QFrame#workflowCard,
QFrame#footerCard {
    padding: 8px;
}

QLabel#m_pLabelServerConfigTitle {
    font-size: 22px;
    font-weight: 700;
    color: #111113;
}

QLabel#m_pLabelServerConfigSummary,
QLabel#m_pLabelSettingsSummary {
    color: #6e6e73;
    font-size: 10.5pt;
}

QLabel#m_pLabelSettingsTitle {
    font-size: 24px;
    font-weight: 700;
    color: #111113;
}

QLineEdit, QTextEdit, QPlainTextEdit, QSpinBox, QComboBox {
    background: #ffffff;
    color: #1d1d1f;
    border: 1px solid #d2d2d7;
    border-radius: 6px;
    padding: 5px 9px;
    min-height: 16px;
}

QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus, QSpinBox:focus, QComboBox:focus {
    border: 1px solid #0071e3;
}

QPushButton {
    background: #1d1d1f;
    color: white;
    border: none;
    border-radius: 8px;
    padding: 7px 12px;
    min-width: 74px;
    font-weight: 600;
}

QPushButton:hover {
    background: #2e2e33;
}

QPushButton:pressed {
    background: #111113;
}

QPushButton#m_pButtonSettings,
QPushButton#m_pButtonReload,
QPushButton#m_pButtonWorkflowHub,
QPushButton#m_pButtonShowLog {
    background: #ffffff;
    color: #1d1d1f;
    border: 1px solid #d2d2d7;
}

QPushButton#m_pButtonSettings:hover,
QPushButton#m_pButtonReload:hover,
QPushButton#m_pButtonWorkflowHub:hover,
QPushButton#m_pButtonShowLog:hover {
    background: #f0f1f5;
}

QPushButton#m_pButtonToggleStart {
    background: #0071e3;
}

QPushButton#m_pButtonToggleStart:hover {
    background: #0062c4;
}

QCheckBox {
    color: #24313d;
    spacing: 8px;
}

QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border-radius: 5px;
    border: 1px solid #9fb3c4;
    background: white;
}

QCheckBox::indicator:checked {
    background: #0f6cbd;
    border: 1px solid #0f6cbd;
}

QToolButton {
    background: transparent;
    border: none;
    color: #0071e3;
}

QListWidget {
    background: transparent;
    border: none;
    outline: none;
    padding: 4px 0;
}

QListWidget::item {
    border: 1px solid #e5e5ea;
    border-radius: 6px;
    background: #ffffff;
    margin: 3px 0;
    padding: 6px 8px;
    color: #1d1d1f;
}

QWizard, QDialog#ServerConfigDialogBase, QDialog#SettingsDialogBase {
    background: #f5f5f7;
}

QWizardPage {
    background: transparent;
}

QTabWidget::pane {
    border: 1px solid #dfdfe4;
    border-radius: 8px;
    background: #fbfbfd;
    top: -1px;
}

QTabBar::tab {
    background: transparent;
    color: #6e6e73;
    padding: 7px 10px;
    margin-right: 6px;
    border-radius: 6px;
}

QTabBar::tab:selected {
    background: #ffffff;
    color: #111113;
    border: 1px solid #e5e5ea;
}

QWizard QLabel#label_3,
QWizard QLabel#label_5,
QWizard QLabel#m_pClientLabel,
QWizard QLabel#m_pServerLabel,
QWizard QLabel#m_pPermissionSummary,
QWizard QLabel#m_pPermissionDetails,
QWizard QLabel#m_pPermissionHint {
    color: #4f4f55;
    font-size: 10.5pt;
    line-height: 1.5;
}

QWizard QRadioButton {
    font-size: 12pt;
    font-weight: 700;
    color: #111113;
}

QDialog#WorkflowHubDialog QTextBrowser {
    background: #ffffff;
    border: 1px solid #e5e5ea;
    border-radius: 8px;
    padding: 8px;
}

QLabel#m_pWorkflowPreview {
    background: #ffffff;
    border: 1px solid #e5e5ea;
    border-radius: 8px;
    color: #6e6e73;
}

QScrollBar:vertical {
    background: transparent;
    width: 12px;
}

QScrollBar::handle:vertical {
    background: #bdd0df;
    border-radius: 6px;
    min-height: 24px;
}

QToolTip {
    background: #24313d;
    color: white;
    border: none;
    padding: 6px 8px;
    border-radius: 8px;
}
