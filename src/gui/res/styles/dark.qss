QMainWindow, QDialog {
    background: #f3f5f8;
    color: #111827;
    font-family: "SF Pro Text", "Helvetica Neue", "PingFang SC", "Segoe UI Variable", sans-serif;
    font-size: 10pt;
}

QWidget {
    color: #111827;
    font-family: "SF Pro Text", "Helvetica Neue", "PingFang SC", "Segoe UI Variable", sans-serif;
    font-size: 10pt;
}

QScrollArea#m_pMainScrollArea {
    background: #f3f5f8;
    border: none;
}

QWidget#dashboardContent {
    background: #f3f5f8;
}

QWidget#controlCenterShell {
    background: #f3f5f8;
}

QFrame#fixedControlBar {
    background: #ffffff;
    border-top: 1px solid #d9dee7;
}

QMenuBar, QMenu {
    background: #ffffff;
    color: #111827;
    border: none;
}

QMenuBar::item {
    padding: 6px 10px;
    border-radius: 6px;
}

QMenuBar::item:selected,
QMenu::item:selected {
    background: #edf2f7;
    color: #0f172a;
}

QFrame#heroCard,
QFrame#overviewCard,
QFrame#workflowCard,
QFrame#footerCard,
QFrame#frame_fingerprint_details,
QFrame#m_pPermissionCard,
QFrame#m_pHeaderCard,
QFrame#m_pSettingsHeaderCard,
QGroupBox {
    background: #ffffff;
    border: 1px solid #d9dee7;
    border-radius: 8px;
}

QFrame#heroCard,
QFrame#overviewCard,
QFrame#workflowCard,
QFrame#footerCard {
    padding: 8px;
}

QFrame#heroCard {
    background: #0f172a;
    border: 1px solid #0f172a;
}

QLabel#m_pLabelHeroTitle {
    color: #ffffff;
    font-size: 20px;
    font-weight: 700;
}

QLabel#m_pLabelHeroSubtitle {
    color: #cbd5e1;
    font-size: 10pt;
}

QGroupBox {
    margin-top: 14px;
    padding: 12px 12px 12px 12px;
    font-weight: 600;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 16px;
    padding: 0 7px;
    color: #1f2937;
    background: #ffffff;
}

QGroupBox::indicator {
    width: 14px;
    height: 14px;
    border-radius: 7px;
    border: 1px solid #94a3b8;
    background: #ffffff;
}

QGroupBox::indicator:checked {
    background: #2563eb;
    border: 1px solid #2563eb;
}

QLabel {
    background: transparent;
    color: #64748b;
}

QLabel#m_pStatusLabel {
    border-radius: 8px;
    padding: 5px 9px;
    font-weight: 600;
}

QLabel#m_pStatusLabel[state="disconnected"] {
    background: #f1f5f9;
    color: #475569;
}

QLabel#m_pStatusLabel[state="connecting"],
QLabel#m_pStatusLabel[state="transfering"] {
    background: #fff7ed;
    color: #9a3412;
}

QLabel#m_pStatusLabel[state="connected"] {
    background: #ecfdf5;
    color: #047857;
}

QLabel#m_pLabelIpAddresses,
QLabel#m_pLabelScreenName,
QLabel#m_pLabelLocalFingerprint,
QLabel#m_pLabelModeValue,
QLabel#m_pLabelPeerValue,
QLabel#m_pLabelWorkflowRuntimeValue,
QLabel#m_pLabelWorkflowSectionTitle {
    color: #111827;
    font-weight: 600;
}

QLabel#m_pLabelModeValue,
QLabel#m_pLabelPeerValue,
QLabel#m_pLabelWorkflowRuntimeValue {
    font-size: 11pt;
}

QLabel#m_pLabelServerHint,
QLabel#m_pLabelClientHint,
QLabel#m_pLabelFeatureHint,
QLabel#m_pLabelReceiptSummary {
    color: #64748b;
    font-size: 9.5pt;
    font-weight: 400;
}

QLabel#m_pLabelModeCaption,
QLabel#m_pLabelPeerCaption,
QLabel#m_pLabelWorkflowRuntimeCaption {
    color: #64748b;
    font-size: 8.5pt;
    font-weight: 600;
}

QLabel#m_pPermissionTitle,
QLabel#m_pLabelWorkflowSectionTitle,
QLabel#m_pLabelServerConfigTitle,
QLabel#m_pLabelSettingsTitle {
    font-size: 16pt;
    font-weight: 700;
    color: #111827;
}

QLabel#m_pLabelServerConfigSummary,
QLabel#m_pLabelSettingsSummary {
    color: #64748b;
    font-size: 10.5pt;
}

QLineEdit, QTextEdit, QPlainTextEdit, QSpinBox, QComboBox {
    background: #ffffff;
    color: #111827;
    border: 1px solid #cbd5e1;
    border-radius: 7px;
    padding: 6px 9px;
    min-height: 20px;
    selection-background-color: #bfdbfe;
}

QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus, QSpinBox:focus, QComboBox:focus {
    border: 1px solid #2563eb;
}

QPushButton:focus, QToolButton:focus {
    border: 1px solid #2563eb;
    background: #eef2ff;
}

QLineEdit:disabled, QTextEdit:disabled, QPlainTextEdit:disabled, QComboBox:disabled {
    background: #f8fafc;
    color: #94a3b8;
    border: 1px solid #e2e8f0;
}

QPushButton {
    background: #ffffff;
    color: #111827;
    border: 1px solid #cbd5e1;
    border-radius: 8px;
    padding: 8px 13px;
    min-width: 76px;
    font-weight: 600;
}

QPushButton:hover {
    background: #f8fafc;
    border: 1px solid #94a3b8;
}

QPushButton:pressed {
    background: #eef2f7;
}

QPushButton:disabled {
    background: #f1f5f9;
    color: #94a3b8;
    border: 1px solid #e2e8f0;
}

QPushButton#m_pButtonToggleStart[state="start"] {
    background: #2563eb;
    color: #ffffff;
    border: 1px solid #2563eb;
}

QPushButton#m_pButtonToggleStart[state="start"]:hover {
    background: #1d4ed8;
    border: 1px solid #1d4ed8;
}

QPushButton#m_pButtonToggleStart[state="stop"] {
    background: #dc2626;
    color: #ffffff;
    border: 1px solid #dc2626;
}

QPushButton#m_pButtonToggleStart[state="stop"]:hover {
    background: #b91c1c;
    border: 1px solid #b91c1c;
}

QPushButton#m_pButtonConfigureServer {
    background: #111827;
    color: #ffffff;
    border: 1px solid #111827;
}

QPushButton#m_pButtonConfigureServer:hover {
    background: #1f2937;
    border: 1px solid #1f2937;
}

QPushButton#m_pButtonToggleStart:focus {
    border: 2px solid #111827;
    padding: 7px 12px;
}

QPushButton#m_pButtonConfigureServer:focus {
    border: 2px solid #60a5fa;
    padding: 7px 12px;
}

QCheckBox, QRadioButton {
    color: #334155;
    spacing: 8px;
}

QCheckBox:focus,
QRadioButton:focus {
    color: #1d4ed8;
}

QCheckBox::indicator,
QRadioButton::indicator {
    width: 17px;
    height: 17px;
    border: 1px solid #94a3b8;
    background: #ffffff;
}

QCheckBox::indicator {
    border-radius: 5px;
}

QRadioButton::indicator {
    border-radius: 9px;
}

QCheckBox::indicator:checked,
QRadioButton::indicator:checked {
    background: #2563eb;
    border: 1px solid #2563eb;
}

QToolButton {
    background: #f8fafc;
    border: 1px solid #d9dee7;
    border-radius: 7px;
    color: #2563eb;
    padding: 4px;
}

QToolButton:hover {
    background: #eef2ff;
    border: 1px solid #bfdbfe;
}

QListWidget {
    background: transparent;
    border: none;
    padding: 2px 0;
}

QListWidget:focus {
    border: 1px solid #2563eb;
}

QListWidget::item {
    border: 1px solid #e2e8f0;
    border-radius: 7px;
    background: #f8fafc;
    margin: 4px 0;
    padding: 8px 9px;
    color: #111827;
}

QListWidget::item:hover {
    background: #eef2ff;
    border: 1px solid #bfdbfe;
}

QWizard, QDialog#ServerConfigDialogBase, QDialog#SettingsDialogBase {
    background: #f3f5f8;
}

QWizardPage {
    background: transparent;
}

QTabWidget::pane {
    border: 1px solid #d9dee7;
    border-radius: 8px;
    background: #ffffff;
    top: -1px;
}

QTabBar::tab {
    background: transparent;
    color: #64748b;
    padding: 7px 10px;
    margin-right: 6px;
    border-radius: 7px;
}

QTabBar::tab:selected {
    background: #f8fafc;
    color: #111827;
    border: 1px solid #e2e8f0;
}

QWizard QLabel#label_3,
QWizard QLabel#label_5,
QWizard QLabel#m_pClientLabel,
QWizard QLabel#m_pServerLabel,
QWizard QLabel#m_pPermissionSummary,
QWizard QLabel#m_pPermissionDetails,
QWizard QLabel#m_pPermissionHint {
    color: #475569;
    font-size: 10.5pt;
}

QWizard QRadioButton {
    font-size: 12pt;
    font-weight: 700;
    color: #111827;
}

QDialog#WorkflowHubDialog QTextBrowser {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    padding: 8px;
}

QLabel#m_pWorkflowPreview {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    color: #64748b;
}

QScrollBar:vertical {
    background: transparent;
    width: 12px;
}

QScrollBar::handle:vertical {
    background: #cbd5e1;
    border-radius: 6px;
    min-height: 24px;
}

QScrollBar::handle:vertical:hover {
    background: #94a3b8;
}

QToolTip {
    background: #111827;
    color: #ffffff;
    border: none;
    padding: 6px 8px;
    border-radius: 8px;
}
