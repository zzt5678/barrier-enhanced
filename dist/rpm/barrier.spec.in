# Internal barrier/synergy build identifiers are retained for source compatibility.
%global barrier_revision @BARRIER_REVISION@
Summary: @WEAVE_PRODUCT_NAME@ keyboard, mouse, and clipboard sharing
Name: weave
Version: @BARRIER_VERSION@
Release: @BARRIER_BUILD_NUMBER@%{?dist}
License: GPLv2
Group: System Environment/Daemons
URL: @WEAVE_PROJECT_URL@
Source0: @WEAVE_PROJECT_URL@/archive/v%{version}.tar.gz

BuildRequires: cmake3
BuildRequires: avahi-compat-libdns_sd-devel
BuildRequires: libX11-devel
BuildRequires: libXtst-devel
BuildRequires: qt5-qtbase-devel
BuildRequires: libcurl-devel
BuildRequires: desktop-file-utils
BuildRequires: openssl-devel

%description
@WEAVE_PRODUCT_NAME@ shares one keyboard, mouse, and clipboard across trusted computers.
Move the pointer across a configured screen edge to control another computer
while each computer continues using its own display.

%prep
# GitHub archives retain the barrier-enhanced repository directory name.
%setup -q -n barrier-enhanced-%{version}


%build
%{cmake3} -DSYNERGY_VERSION_STAGE:STRING=@BARRIER_VERSION_STAGE@ -DSYNERGY_REVISION:STRING=%{barrier_revision} .
make %{?_smp_mflags}


%install
install -D -p -m 0755 bin/weave %{buildroot}%{_bindir}/weave
install -D -p -m 0755 bin/weavec %{buildroot}%{_bindir}/weavec
install -D -p -m 0755 bin/weaves %{buildroot}%{_bindir}/weaves
# Source assets retain legacy barrier filenames; installed files use Weave names.
install -D -p -m 0644 doc/barrierc.1 %{buildroot}%{_mandir}/man1/weavec.1
install -D -p -m 0644 doc/barriers.1 %{buildroot}%{_mandir}/man1/weaves.1
install -D -p -m 0644 res/barrier.desktop %{buildroot}%{_datadir}/applications/weave.desktop
install -D -p -m 0644 res/barrier.svg %{buildroot}%{_datadir}/icons/hicolor/scalable/apps/weave.svg

cd %{buildroot}%{_bindir}

mkdir -p %{buildroot}%{_datadir}/metainfo
## Write AppStream
cat <<END> %{buildroot}%{_datadir}/metainfo/%{name}.appdata.xml
<?xml version="1.0" encoding="UTF-8"?>
<!-- Copyright 2018 Ding-Yi Chen <dchen@redhat.com> -->
<component type="desktop-application">
  <id>%{name}</id>
  <metadata_license>FSFAP</metadata_license>
  <project_license>GPLv2</project_license>
  <name>@WEAVE_PRODUCT_NAME@</name>
  <summary>Share one keyboard, mouse, and clipboard across trusted computers</summary>

  <description>
    <p>
      @WEAVE_PRODUCT_NAME@ shares one keyboard, mouse, and clipboard across trusted computers.
      Move the pointer across a configured screen edge to control another computer
      while each computer continues using its own display.
    </p>
  </description>

  <launchable type="desktop-id">%{name}.desktop</launchable>

  <url type="homepage">@WEAVE_PROJECT_URL@</url>

  <provides>
    <binary>weave</binary>
    <binary>weavec</binary>
    <binary>weaves</binary>
  </provides>

</component>
END

desktop-file-install --delete-original \
  --dir %{buildroot}%{_datadir}/applications \
  --set-icon=%{_datadir}/icons/hicolor/scalable/apps/weave.svg \
  %{buildroot}%{_datadir}/applications/weave.desktop

desktop-file-validate %{buildroot}/%{_datadir}/applications/weave.desktop

%files
# None of the documentation files are actually useful here, they all point to
# the online website, so include just one, the README
# The example config retains its legacy source filename for compatibility.
%doc LICENSE ChangeLog res/Readme.txt doc/barrier.conf.example*
%{_bindir}/weave
%{_bindir}/weavec
%{_bindir}/weaves
%{_datadir}/icons/hicolor/scalable/apps/weave.svg
%{_datadir}/applications/weave.desktop
%{_datadir}/metainfo/%{name}.appdata.xml
%{_mandir}/man1/weavec.1*
%{_mandir}/man1/weaves.1*

%changelog
* Thu Mar 21 2019 wendall911 <wendallc@83864.com>
- Actual working spec file for Fedora

* Sat Jan 27 2018 Debauchee <todo@mail.com>
- Initial version of the package
