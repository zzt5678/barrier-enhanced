#!/bin/sh

# Use the same verbose variable as CMake
[ "$VERBOSE" = "1" ] && set -x

# Exit on unset variables or pipe errors
set -uo pipefail

B_MACOS="Weave.app/Contents/MacOS"
B_VERSION="@BARRIER_VERSION@"
B_BINDIR="@CMAKE_RUNTIME_OUTPUT_DIRECTORY@"
B_BUILDTYPE="@CMAKE_BUILD_TYPE@"
B_BARRIERC="Weave.app/Contents/MacOS/weavec"
B_BARRIERS="Weave.app/Contents/MacOS/weaves"
DEPLOYQT="${DEPLOYQT:-}"

# Colorized output
color() { tput "$@" 2>/dev/null || true; }
info() { color bold; echo "$@"; color sgr0; }
error() { color bold; color setaf 1; echo "$@"; color sgr0; }
success() { color bold; color setaf 2; echo "$@"; color sgr0; }
warn() { color bold; color setaf 3; echo "$@"; color sgr0; }

info "Checking for bundle contents"
if [ ! -d "Weave.app/Contents" ]; then
    error "Please make sure that the build completed successfully"
    error "before trying to create the installer."
    exit 1
fi

if [ -d "$B_MACOS" ]; then
    info "Removing old binaries from bundle"
    rm -r "$B_MACOS" || exit 1
fi

info "Copying binaries into bundle"
# Include only shipping components, never test executables from the build.
mkdir -p "$B_MACOS" || exit 1
for component in weave weavec weaves; do
    if [ ! -x "$B_BINDIR/$component" ]; then
        error "Missing executable: $B_BINDIR/$component"
        exit 1
    fi
    cp "$B_BINDIR/$component" "$B_MACOS/$component" || exit 1
done

if [ -z "$DEPLOYQT" ]; then
    DEPLOYQT="$(command -v macdeployqt || true)"
fi

# Check for macdeployqt on MacPorts
if [ -z "$DEPLOYQT" ] && command -v port >/dev/null 2>&1; then
    info "MacPorts found, searching for macdeployqt"
    DEPLOYQT="$(port contents qt5-qttools | grep --only --max-count 1 '/.*macdeployqt')"
    if [ ! -x "$DEPLOYQT" ]; then
        error "Please install package qt5-qttools"
        exit 1
    fi
fi

# Check for macdeployqt on Homebrew
if [ -z "$DEPLOYQT" ] && command -v brew >/dev/null 2>&1; then
    info "Homebrew found, searching for macdeployqt"
    DEPLOYQT="$(brew list qt@5 | grep --only '/.*macdeployqt' | head -1)"
    if [ ! -x "$DEPLOYQT" ]; then
        error "Please install package qt"
        exit 1
    fi
fi

if [ -z "$DEPLOYQT" ] || [ ! -x "$DEPLOYQT" ]; then
    error "macdeployqt not found; set DEPLOYQT to an executable Qt 5 macdeployqt path"
    exit 1
fi

# Use macdeployqt to include libraries and create dmg
if [ "$B_BUILDTYPE" = "Release" ]; then
    info "Building Release disk image (dmg)"
    "$DEPLOYQT" Weave.app -dmg \
    -executable="$B_BARRIERC" \
    -executable="$B_BARRIERS" || exit 1
    mv "Weave.dmg" "Weave-$B_VERSION.dmg" || exit 1
    success "Created Weave-$B_VERSION.dmg"
else
    warn "Disk image (dmg) only created for Release builds"
    info "Building debug bundle"
    "$DEPLOYQT" Weave.app -no-strip \
    -executable="$B_BARRIERC" \
    -executable="$B_BARRIERS" || exit 1
    success "Bundle created successfully"
fi
