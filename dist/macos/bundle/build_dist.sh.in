#!/bin/sh

# Use the same verbose variable as CMake
[ "$VERBOSE" = "1" ] && set -x

# Exit on unset variables or pipe errors
set -uo pipefail

B_MACOS="Weave.app/Contents/MacOS"
B_VERSION="@BARRIER_VERSION@"
B_BINDIR="@CMAKE_RUNTIME_OUTPUT_DIRECTORY@"
B_BUILDTYPE="@CMAKE_BUILD_TYPE@"
B_BARRIERC="Weave.app/Contents/MacOS/weavec"
B_BARRIERS="Weave.app/Contents/MacOS/weaves"
DEPLOYQT="${DEPLOYQT:-}"

# Colorized output
color() { tput "$@" 2>/dev/null || true; }
info() { color bold; echo "$@"; color sgr0; }
error() { color bold; color setaf 1; echo "$@"; color sgr0; }
success() { color bold; color setaf 2; echo "$@"; color sgr0; }
warn() { color bold; color setaf 3; echo "$@"; color sgr0; }

info "Checking for bundle contents"
if [ ! -d "Weave.app/Contents" ]; then
    error "Please make sure that the build completed successfully"
    error "before trying to create the installer."
    exit 1
fi

if [ -d "$B_MACOS" ]; then
    info "Removing old binaries from bundle"
    rm -r "$B_MACOS" || exit 1
fi

info "Copying binaries into bundle"
# Include only shipping components, never test executables from the build.
mkdir -p "$B_MACOS" || exit 1
for component in weave weavec weaves; do
    if [ ! -x "$B_BINDIR/$component" ]; then
        error "Missing executable: $B_BINDIR/$component"
        exit 1
    fi
    cp "$B_BINDIR/$component" "$B_MACOS/$component" || exit 1
done

if [ -z "$DEPLOYQT" ]; then
    DEPLOYQT="$(command -v macdeployqt || true)"
fi

# Check for macdeployqt on MacPorts
if [ -z "$DEPLOYQT" ] && command -v port >/dev/null 2>&1; then
    info "MacPorts found, searching for macdeployqt"
    DEPLOYQT="$(port contents qt5-qttools | grep --only --max-count 1 '/.*macdeployqt')"
    if [ ! -x "$DEPLOYQT" ]; then
        error "Please install package qt5-qttools"
        exit 1
    fi
fi

# Check for macdeployqt on Homebrew
if [ -z "$DEPLOYQT" ] && command -v brew >/dev/null 2>&1; then
    info "Homebrew found, searching for macdeployqt"
    DEPLOYQT="$(brew list qt@5 | grep --only '/.*macdeployqt' | head -1)"
    if [ ! -x "$DEPLOYQT" ]; then
        error "Please install package qt"
        exit 1
    fi
fi

if [ -z "$DEPLOYQT" ] || [ ! -x "$DEPLOYQT" ]; then
    error "macdeployqt not found; set DEPLOYQT to an executable Qt 5 macdeployqt path"
    exit 1
fi

# Deploy dependencies first. macdeployqt can report signing errors yet return
# success, so signing and strict verification are explicit gates before a DMG.
if [ "$B_BUILDTYPE" = "Release" ]; then
    info "Building Release disk image (dmg)"
    "$DEPLOYQT" Weave.app \
    -executable="$B_BARRIERC" \
    -executable="$B_BARRIERS" || exit 1
else
    warn "Disk image (dmg) only created for Release builds"
    info "Building debug bundle"
    "$DEPLOYQT" Weave.app -no-strip \
    -executable="$B_BARRIERC" \
    -executable="$B_BARRIERS" || exit 1
fi

# Qt 5's deployer can omit WebP's @rpath SharpYUV dependency. Resolve it
# beside the original WebP install ID, not from an architecture-specific prefix.
for webp in Weave.app/Contents/Frameworks/libwebp*.dylib; do
    [ -f "$webp" ] || continue
    if otool -L "$webp" | grep -q '@rpath/libsharpyuv.0.dylib'; then
        sharp="Weave.app/Contents/Frameworks/libsharpyuv.0.dylib"
        if [ ! -f "$sharp" ]; then
            origin="$(otool -D "$webp" | sed -n '2p')"
            case "$origin" in
                /*) ;;
                *)
                    # macdeployqt may already have rewritten the install ID.
                    # Query the matching Qt installation's original plugin.
                    qmake="$(dirname "$DEPLOYQT")/qmake"
                    plugins="$("$qmake" -query QT_INSTALL_PLUGINS)" || exit 1
                    origin="$(otool -L "$plugins/imageformats/libqwebp.dylib" |
                        awk '$1 ~ /\/libwebp\.[0-9].*dylib$/ {print $1; exit}')" || exit 1
                    ;;
            esac
            source="$(dirname "$origin")/libsharpyuv.0.dylib"
            if [ ! -f "$source" ]; then
                error "Missing WebP dependency: $source"
                exit 1
            fi
            cp "$source" "$sharp" || exit 1
            chmod u+w "$sharp" || exit 1
            install_name_tool -id '@loader_path/libsharpyuv.0.dylib' "$sharp" || exit 1
        fi
        install_name_tool -change '@rpath/libsharpyuv.0.dylib' \
            '@loader_path/libsharpyuv.0.dylib' "$webp" || exit 1
    fi
done

# Local ad-hoc signing supports Apple Silicon execution; this is not notarized.
minimum_os="$(bash "$(dirname "$0")/minimum_macos.sh" Weave.app)" || {
    error "Could not determine minimum macOS version from bundled Mach-O files"
    exit 1
}
"${PLISTBUDDY:-/usr/libexec/PlistBuddy}" -c \
    "Set :LSMinimumSystemVersion $minimum_os" Weave.app/Contents/Info.plist || exit 1
codesign --force --deep --sign - Weave.app || exit 1
codesign --verify --deep --strict Weave.app || exit 1
if [ "$B_BUILDTYPE" = "Release" ]; then
    hdiutil create -ov -format UDZO -volname Weave \
        -srcfolder Weave.app "Weave-$B_VERSION.dmg" || exit 1
    success "Created Weave-$B_VERSION.dmg (ad-hoc signed, not notarized)"
else
    success "Bundle created successfully (ad-hoc signed, not notarized)"
fi
