<?xml version="1.0" encoding="utf-8"?>
<Include>
    <?define Name="@WEAVE_PRODUCT_NAME@" ?>
    <?define Version="@BARRIER_WIX_VERSION@" ?>
    <?define QtVersion="@QT_VERSION@" ?>
    <?define Author="@WEAVE_PRODUCT_PUBLISHER@" ?>
    <?define Web="@WEAVE_PROJECT_URL@" ?>
    <?define ServiceName="@WEAVE_SERVICE_NAME@" ?>
    <?define ServiceDisplayName="@WEAVE_SERVICE_DISPLAY_NAME@" ?>
    <?define ServiceDescription="@WEAVE_SERVICE_DESCRIPTION@" ?>
    <?define BinPath="@CMAKE_BINARY_DIR@/windows-release/$(var.Configuration)/payload" ?>
    <?define ReleaseManifestPath="@CMAKE_BINARY_DIR@/windows-release/$(var.Configuration)/manifest.sha256" ?>
    <?define VcRedistMinimumVersion="@WEAVE_VC_REDIST_MIN_VERSION@" ?>
    <?define VcRedistMajorVersion="@WEAVE_VC_REDIST_MAJOR_VERSION@" ?>
    <?define VcRedistMinorVersion="@WEAVE_VC_REDIST_MINOR_VERSION@" ?>
    <?define ResPath="@CMAKE_CURRENT_SOURCE_DIR@/res" ?>
    <?if $(var.Platform) = "x64" ?>
        <?define ProgramFilesFolder="ProgramFiles64Folder" ?>
        <?define PlatformSimpleName="64-bit" ?>
        <?define UpgradeGuid="8B5E12D6-57C0-4B70-BE15-FFFE47230272" ?>
    <?else ?>
        <?define ProgramFilesFolder="ProgramFilesFolder" ?>
        <?define PlatformSimpleName="32-bit" ?>
        <?define UpgradeGuid="F0D33EF8-15CE-4A26-BEA3-8E281655A2C1" ?>
    <?endif ?>
</Include>
